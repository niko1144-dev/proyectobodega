# Puerto del backend (opcional)
PORT=4000

# URI de conexión a MongoDB (obligatorio)
# Ejemplo local:
# MONGODB_URI=mongodb://127.0.0.1:27017/proyectobodega
# Ejemplo Atlas:
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/proyectobodega?retryWrites=true&w=majority
MONGODB_URI=

# Clave para firmar tokens JWT (obligatorio en producción)
JWT_SECRET=cambia-esta-clave-secreta

# Variables opcionales para poblar usuario admin con `npm run seed`
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@bodega.local
SEED_ADMIN_PASSWORD=admin1234

# Opcional: usuarios simulados para Active Directory en formato JSON
# AD_MOCK_USERS=[{"username":"jdoe","displayName":"John Doe","email":"jdoe@example.com"}]
AD_MOCK_USERS=
