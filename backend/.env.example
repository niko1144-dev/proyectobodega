# Puerto del servidor Backend API
PORT=4000

# Conexión a Base de Datos PostgreSQL
# Ejemplo Docker: postgresql://postgres:postgres@localhost:5432/itam_chileatiende?schema=public
# Ejemplo Homebrew Mac: postgresql://$(whoami)@localhost:5432/itam_chileatiende?schema=public
DATABASE_URL="postgresql://mda@localhost:5432/itam_chileatiende?schema=public"

# Configuración de Entorno
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# =========================================================================
# CONFIGURACIÓN ACTIVE DIRECTORY / LDAP MULTI-DOMINIO (USUARIOS ASIGNABLES)
# =========================================================================
# NOTA DE SEGURIDAD & ARQUITECTURA:
# Este módulo se utiliza EXCLUSIVAMENTE para sincronizar el catálogo de colaboradores
# asignables ("users_ad_cache"). La autenticación de administradores/técnicos de la
# plataforma se realiza mediante credenciales internas desacopladas (tabla "platform_users").
LDAP_ENABLED="true"

# 1. Dominio 1: ChileAtiende (CHA - cha.cl)
LDAP_CHA_ENABLED="true"
LDAP_CHA_HOST="ldap://scha01.cha.cl:389"
LDAP_CHA_BACKUP_URL="ldap://dc02.cha.cl:389"
LDAP_CHA_BASE_DN="DC=cha,DC=cl"
LDAP_CHA_BIND_USER="ngalarceg.srv@cha.cl"
LDAP_CHA_BIND_PASS="cha.2029"
LDAP_CHA_DOMAIN="cha.cl"
LDAP_CHA_TIMEOUT_MS=7000
LDAP_CHA_CONNECT_TIMEOUT_MS=4000

# 2. Dominio 2: Instituto de Previsión Social (IPS - ips.gob.cl)
LDAP_IPS_ENABLED="true"
LDAP_IPS_HOST="ldap://dc05.ips.gob.cl:389"
LDAP_IPS_BACKUP_URL="ldap://dc06.ips.gob.cl:389"
LDAP_IPS_BASE_DN="DC=ips,DC=gob,DC=cl"
LDAP_IPS_BIND_USER="ngalarceg.srv@ips.gob.cl"
LDAP_IPS_BIND_PASS="cha.2024"
LDAP_IPS_DOMAIN="ips.gob.cl"
LDAP_IPS_TIMEOUT_MS=15000
LDAP_IPS_CONNECT_TIMEOUT_MS=6000

# Retrocompatibilidad con variables alternativas / alias
LDAP_CHA_URL="ldap://scha01.cha.cl:389"
LDAP_CHA_BIND_PASSWORD="cha.2029"
LDAP_IPS_URL="ldap://dc05.ips.gob.cl:389"
LDAP_IPS_BIND_PASSWORD="cha.2024"

# ==========================================
# CONFIGURACIÓN SERVIDOR SMTP / RELAY INSTITUCIONAL
# ==========================================
SMTP_ENABLED="true"
SMTP_HOST="relaycha.cha.cl"
SMTP_PORT=25
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Gestión de Activos TI ChileAtiende <notificaciones-itam@chileatiende.cl>"
APP_URL="http://localhost:3000"
