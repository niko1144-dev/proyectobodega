# Puerto del servidor Backend API
PORT=4000

# Conexión a Base de Datos PostgreSQL local (Homebrew)
DATABASE_URL="postgresql://mda@localhost:5432/itam_chileatiende?schema=public"

# Configuración de Entorno
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ==========================================
# CONFIGURACIÓN ACTIVE DIRECTORY / LDAP MULTI-DOMINIO
# ==========================================
LDAP_ENABLED="true"

# 1. Dominio Primario: ChileAtiende (CHA) - Prioridad 1
LDAP_CHA_ENABLED="true"
LDAP_CHA_URL="ldap://scha01.cha.cl:389"
LDAP_CHA_BACKUP_URL="ldap://dc02.cha.cl:389"
LDAP_CHA_BIND_USER="ngalarceg.srv@chileatiende.cl"
LDAP_CHA_BIND_PASSWORD="cha.2029"
LDAP_CHA_BASE_DN="DC=cha,DC=cl"
LDAP_CHA_DOMAIN="cha.cl"
LDAP_CHA_TIMEOUT_MS=7000
LDAP_CHA_CONNECT_TIMEOUT_MS=4000

# 2. Dominio Secundario: Instituto de Previsión Social (IPS) - Fallback
LDAP_IPS_ENABLED="true"
LDAP_IPS_URL="ldap://sips01.ips.gob.cl:389"
LDAP_IPS_BACKUP_URL="ldap://dc01.ips.gob.cl:389"
LDAP_IPS_BIND_USER="ngalarceg.srv@chileatiende.cl"
LDAP_IPS_BIND_PASSWORD="cha.2029"
LDAP_IPS_BASE_DN="DC=ips,DC=gob,DC=cl"
LDAP_IPS_DOMAIN="ips.gob.cl"
LDAP_IPS_TIMEOUT_MS=7000
LDAP_IPS_CONNECT_TIMEOUT_MS=4000

# Retrocompatibilidad de variables legadas
LDAP_URL="ldap://scha01.cha.cl:389"
LDAP_BIND_USER="ngalarceg.srv@chileatiende.cl"
LDAP_BIND_PASSWORD="cha.2029"
LDAP_BASE_DN="DC=cha,DC=cl"
LDAP_DOMAIN="cha.cl"
